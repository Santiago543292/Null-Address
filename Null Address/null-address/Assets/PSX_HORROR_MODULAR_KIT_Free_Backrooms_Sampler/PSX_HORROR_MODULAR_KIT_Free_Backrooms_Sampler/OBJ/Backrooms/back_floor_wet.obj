# PSX Horror Modular Kit by bitkiln - back_floor_wet
# Soaked carpet with dark wet patches, 2 x 2 m floor tile at y = 0.
# metres, +Y up, origin = centre of the cell floor
mtllib back_floor_wet.mtl
o back_floor_wet
v -1.00000 0.00000 1.00000
v 0.00000 0.00000 1.00000
v 1.00000 0.00000 1.00000
v -1.00000 0.00000 0.00000
v 0.00000 0.00000 0.00000
v 1.00000 0.00000 0.00000
v -1.00000 0.00000 -1.00000
v 0.00000 0.00000 -1.00000
v 1.00000 0.00000 -1.00000
vt -1.00000 0.00000
vt 0.00000 0.00000
vt 1.00000 0.00000
vt -1.00000 1.00000
vt 0.00000 1.00000
vt 1.00000 1.00000
vt -1.00000 2.00000
vt 0.00000 2.00000
vt 1.00000 2.00000
vn 0.0000 1.0000 0.0000
vn 0.0000 1.0000 0.0000
vn 0.0000 1.0000 0.0000
vn 0.0000 1.0000 0.0000
vn 0.0000 1.0000 0.0000
vn 0.0000 1.0000 0.0000
vn 0.0000 1.0000 0.0000
vn 0.0000 1.0000 0.0000
vn 0.0000 1.0000 0.0000
g back_floor_wet_floor_wet
usemtl back_floor_wet
s off
f 1/1/1 2/2/2 5/5/5
f 1/1/1 5/5/5 4/4/4
f 2/2/2 3/3/3 6/6/6
f 2/2/2 6/6/6 5/5/5
f 4/4/4 5/5/5 8/8/8
f 4/4/4 8/8/8 7/7/7
f 5/5/5 6/6/6 9/9/9
f 5/5/5 9/9/9 8/8/8
