# PSX Horror Modular Kit by bitkiln - back_ceiling
# Stained acoustic ceiling tiles, 2 x 2 m quad at y = 3 facing down.
# metres, +Y up, origin = centre of the cell floor
mtllib back_ceiling.mtl
o back_ceiling
v -1.00000 3.00000 -1.00000
v 0.00000 3.00000 -1.00000
v 1.00000 3.00000 -1.00000
v -1.00000 3.00000 0.00000
v 0.00000 3.00000 0.00000
v 1.00000 3.00000 0.00000
v -1.00000 3.00000 1.00000
v 0.00000 3.00000 1.00000
v 1.00000 3.00000 1.00000
vt -1.00000 0.00000
vt 0.00000 0.00000
vt 1.00000 0.00000
vt -1.00000 1.00000
vt 0.00000 1.00000
vt 1.00000 1.00000
vt -1.00000 2.00000
vt 0.00000 2.00000
vt 1.00000 2.00000
vn 0.0000 -1.0000 0.0000
vn 0.0000 -1.0000 0.0000
vn 0.0000 -1.0000 0.0000
vn 0.0000 -1.0000 0.0000
vn 0.0000 -1.0000 0.0000
vn 0.0000 -1.0000 0.0000
vn 0.0000 -1.0000 0.0000
vn 0.0000 -1.0000 0.0000
vn 0.0000 -1.0000 0.0000
g back_ceiling_ceiling
usemtl back_ceiling
s off
f 1/1/1 2/2/2 5/5/5
f 1/1/1 5/5/5 4/4/4
f 2/2/2 3/3/3 6/6/6
f 2/2/2 6/6/6 5/5/5
f 4/4/4 5/5/5 8/8/8
f 4/4/4 8/8/8 7/7/7
f 5/5/5 6/6/6 9/9/9
f 5/5/5 9/9/9 8/8/8
