; PSX Horror Monsters - Free Sampler - Godot 4.3 project - bitkiln - https://bitkiln.itch.io
; Open this file with Godot 4.3 or newer and press F5 for the monster showcase (demo/hunt.tscn is the hunt demo).
; The [importer_defaults] below keep the textures sharp and lossless: copy that block into your own
; project.godot before you add the monsters to your project (see README_GODOT.md).

config_version=5

[application]

config/name="PSX Horror Monsters - Free Sampler"
config/description="Free sampler of PSX Horror Monsters: 2 animated enemies, the enemy behaviour script and both demos."
run/main_scene="res://demo/showcase.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
boot_splash/bg_color=Color(0.078, 0.063, 0.071, 1)
config/icon="res://icon.png"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[importer_defaults]

scene={
"gltf/embedded_image_handling": 3,
"meshes/generate_lods": false,
"animation/fps": 30
}
texture={
"compress/mode": 0,
"detect_3d/compress_to": 0,
"mipmaps/generate": true
}

